# ==============================================================================
# VIESSMANN VICARE API CREDENTIALS
# ==============================================================================
# Inserisci qui l'email e la password con cui accedi all'app ViCare sullo smartphone
VIESSMANN_USER=tua_email_vicare@example.com
VIESSMANN_PASSWORD=tua_password_vicare
VIESSMANN_CLIENT_ID=il_tuo_client_id_viessmann
VIESSMANN_TOKEN_FILE=token.save

# ==============================================================================
# BTICINO / LEGRAND / NETATMO ENERGY API CREDENTIALS
# ==============================================================================
# Ottenibili gratuitamente su https://dev.netatmo.com/
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_USER=
NETATMO_PASSWORD=

# ==============================================================================
# LOGGING & APP SETTINGS
# ==============================================================================
POLL_INTERVAL_MINUTES=10
DATABASE_PATH=data/vitocal_telemetry.db
LOG_LEVEL=INFO

# ==============================================================================
# WEATHER FORECAST (OPEN-METEO - PRIVACY PROTECTED)
# ==============================================================================
# Coordinate da inserire SOLO in .env locale e nei GitHub Secrets (mai nel codice)
# WEATHER_LAT=46.0000
# WEATHER_LON=10.0000
# WEATHER_ELEVATION_M=1000
